# 기본 LLM: 로컬 Ollama. API 키·호출량·과금 제한 없음.
# Unity와 함께 실행하는 8GB PC 권장 모델: ollama run qwen2.5:1.5b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_FEEDBACK_MODEL=qwen2.5:1.5b

# Gemini 3.6 Flash — 저지연 면접 질문/반응용 주 공급자
# 키 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 선택적 예비 공급자: NVIDIA NIM 무료 프로토타입 Kimi K2.6
# 키 발급: https://build.nvidia.com/moonshotai/kimi-k2.6
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=moonshotai/kimi-k2.6

# 전북AI 학생 API (OpenAI 호환, 키는 절대 커밋 금지)
JEONBUK_API_KEY=
JEONBUK_BASE_URL=https://ai.jb.go.kr/student-api/v1
JEONBUK_CHAT_MODEL=gemma-4-31b-turbo

# STT 공급자. 전북 API 키가 없으면 local 사용
STT_PROVIDER=local
JEONBUK_STT_MODEL=cohere-transcribe

# Claude (LLM_PROVIDER=claude 일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# 로컬 STT fallback (STT_PROVIDER=local)
WHISPER_MODEL=medium

# Unity 면접관 TTS (서버에만 보관, Quest/Unity 빌드에는 넣지 않음)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
